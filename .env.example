# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required: your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: path to the SQLite database file (default: ./data/medlens.db)
DB_PATH=./data/medlens.db

# Optional: port the server listens on (Cloud Run sets this automatically)
PORT=3001

# Optional: max file size in bytes for uploads (default: 10485760 = 10MB)
MAX_FILE_SIZE=10485760
